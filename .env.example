# EchoVeille — variables d'environnement nécessaires
# Ne mettez JAMAIS les vraies valeurs dans ce fichier ni dans Git.
# Configurez-les dans Render → votre service → Environment.

# Connexion à votre base Supabase (Settings → Database → Connection string → URI)
DATABASE_URL=postgres://...

# Clé secrète pour signer les sessions (générez une longue chaîne aléatoire, ex: openssl rand -hex 32)
APP_SECRET=change-moi-en-une-longue-chaine-aleatoire

# URL de votre projet Supabase (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé "service_role" de Supabase (Settings → API → service_role secret)
# ATTENTION : cette clé donne un accès total, ne jamais l'exposer côté front-end.
SUPABASE_SERVICE_KEY=eyJ...
